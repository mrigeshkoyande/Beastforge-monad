{
  "framework": "nextjs",
  "rootDirectory": "apps/web",
  "env": {
    "NEXT_PUBLIC_MONAD_RPC": "@monad_rpc",
    "NEXT_PUBLIC_HUNT_CORE_ADDRESS": "@hunt_core_address",
    "NEXT_PUBLIC_BEAST_NFT_ADDRESS": "@beast_nft_address"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
