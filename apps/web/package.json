{
  "name": "monad-hunt-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "keep-alive": "node scripts/keep-alive.js",
    "keep-alive:prod": "node scripts/keep-alive.js $NEXT_PUBLIC_SITE_URL",
